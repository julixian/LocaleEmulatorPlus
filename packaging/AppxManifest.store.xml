<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store MSIX 清单模板。
  上架前在 Partner Center 创建应用后，将 Identity/@Name、Identity/@Publisher 与
  Properties/PublisherDisplayName 替换为 Partner Center 分配的正式值。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap10 rescap desktop4 desktop5 com">

  <Identity
    Name="julixian.LocaleEmulatorPlus"
    Publisher="CN=93DB9627-2815-49E1-8B58-A7EB2CCC8220"
    Version="3.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Locale Emulator Plus</DisplayName>
    <PublisherDisplayName>julixian</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
    <Resource Language="ja-JP" />
  </Resources>

  <Applications>
    <Application Id="LEP" Executable="LEPWinUI.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Locale Emulator Plus"
        Description="Locale emulation launcher and profile manager for Windows applications."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="LocaleEmulatorPlusMenu" Clsid="A84F3C21-6E9D-4B2A-9F1E-3D7C5B8A2030" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Locale Emulator Plus Context Menu">
              <com:Class Id="A84F3C21-6E9D-4B2A-9F1E-3D7C5B8A2030" Path="LEPShellExt.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
