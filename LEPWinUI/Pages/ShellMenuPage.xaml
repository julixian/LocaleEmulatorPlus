<Page
    x:Class="LEPWinUI.Pages.ShellMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleTextStyle}" Margin="0" />
            <InfoBar x:Name="FeedbackBar" IsOpen="False" IsClosable="True" />

            <!-- Win11 一级右键菜单卡片 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="Win11HeaderText" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                    <TextBlock x:Name="Win11StatusText" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="Win11HintText"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="Win11ButtonsPanel" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button x:Name="Win11InstallBtn" Style="{StaticResource AccentButtonStyle}" Click="Win11InstallBtn_Click" />
                        <Button x:Name="Win11UninstallBtn" Click="Win11UninstallBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 经典右键菜单卡片 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ClassicHeaderText" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UserStatusText" Grid.Column="0" VerticalAlignment="Center" />
                        <Button x:Name="UserInstallBtn" Grid.Column="1" Click="UserInstallBtn_Click" />
                        <Button x:Name="UserUninstallBtn" Grid.Column="2" Click="UserUninstallBtn_Click" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AllStatusText" Grid.Column="0" VerticalAlignment="Center" />
                        <Button x:Name="AllInstallBtn" Grid.Column="1" Click="AllInstallBtn_Click" />
                        <Button x:Name="AllUninstallBtn" Grid.Column="2" Click="AllUninstallBtn_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 辅助工具卡片（仅便携版显示） -->
            <Border x:Name="ToolsCard" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ToolsHeaderText" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                    <TextBlock
                        x:Name="RestartExplorerHintText"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button x:Name="RestartExplorerBtn" Click="RestartExplorerBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
