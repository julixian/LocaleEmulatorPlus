#include <winver.h>
#include "../LEPCommon/LEPMacros.hpp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LEP_APP_VERSION_MAJOR,LEP_APP_VERSION_MINOR,LEP_APP_VERSION_PATCH,0
 PRODUCTVERSION LEP_APP_VERSION_MAJOR,LEP_APP_VERSION_MINOR,LEP_APP_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "julixian"
            VALUE "FileDescription", "Locale Emulator Plus 32-bit Launch Helper"
            VALUE "FileVersion", LEP_APP_VERSION_STR
            VALUE "InternalName", "LEPHelper_x86.exe"
            VALUE "OriginalFilename", "LEPHelper_x86.exe"
            VALUE "ProductName", "Locale Emulator Plus"
            VALUE "ProductVersion", LEP_APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
