<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <FontFamily x:Key="UIFont">Segoe UI</FontFamily>
    <system:String x:Key="EnterArgument">Enter argument here (if any)</system:String>
    <system:String x:Key="Save">Save</system:String>
    <system:String x:Key="Shortcut">Create shortcut</system:String>
    <system:String x:Key="Cancel">Cancel</system:String>
    <system:String x:Key="SaveAs">Save As ...</system:String>
    <system:String x:Key="SaveAsInstruction">New profile name:</system:String>
    <system:String x:Key="Delete">Delete</system:String>
    <system:String x:Key="ConfirmDel">Are you sure you want to delete this profile?</system:String>
    <system:String x:Key="Location">Location</system:String>
    <system:String x:Key="LocationSettings">Location Settings</system:String>
    <system:String x:Key="TimezoneSettings">Timezone Settings</system:String>
    <system:String x:Key="Timezone">Timezone</system:String>
    <system:String x:Key="DebugOptions">Advanced Options</system:String>
    <system:String x:Key="AsAdmin">Run as administrator</system:String>
    <system:String x:Key="WithCREATESUSPENDED">Create process with CREATE__SUSPENDED</system:String>
    <system:String x:Key="Miscellaneous">Miscellaneous</system:String>
    <system:String x:Key="ShowInMainMenu">Show this profile in main menu</system:String>
    <system:String x:Key="RegistryRedirectionMode">Registry redirection</system:String>
    <system:String x:Key="RegistryRedirectionCore">0 - Core (3 values)</system:String>
    <system:String x:Key="RegistryRedirectionBasic">1 - Basic (4 values)</system:String>
    <system:String x:Key="RegistryRedirectionAdvanced">2 - Advanced (8 values)</system:String>
    <system:String x:Key="HookUILanguageMode">UI language hook</system:String>
    <system:String x:Key="UILanguageHookOff">0 - Off</system:String>
    <system:String x:Key="UILanguageHookWin32">1 - Win32 APIs</system:String>
    <system:String x:Key="UILanguageHookNative">2 - Native APIs + MUI</system:String>
</ResourceDictionary>
