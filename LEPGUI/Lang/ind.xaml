    <system:String x:Key="Cancel">Batal</system:String>
    <system:String x:Key="SaveAs">Simpan sebagai ...</system:String>
    <system:String x:Key="SaveAsInstruction">Nama profil baru:</system:String>
    <system:String x:Key="Delete">Hapus</system:String>
    <system:String x:Key="ConfirmDel">Anda yakin ingin menghapus profil ini?</system:String>
    <system:String x:Key="Location">Lokasi</system:String>
